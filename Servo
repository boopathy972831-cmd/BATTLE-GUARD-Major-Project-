
#include <LPC21xx.h>

void PWM_Init(void)
{
    PINSEL0 |= (1<<0);      // P0.0 as PWM1

    PWMPCR = (1<<9);        // Enable PWM1 output
    PWMMR0 = 20000;         // 20 ms period
    PWMMR1 = 1500;          // 90 degree position

    PWMMCR = (1<<1);        // Reset on MR0
    PWMLER = (1<<0) | (1<<1);

    PWMTCR = (1<<1);        // Reset PWM counter
    PWMTCR = (1<<0) | (1<<3); // Enable PWM and counter
}

int main()
{
    PWM_Init();

    while(1)
    {
        PWMMR1 = 1000;      // 0 degree
        PWMLER = (1<<1);
        delay_ms(1000);

        PWMMR1 = 1500;      // 90 degree
        PWMLER = (1<<1);
        delay_ms(1000);

        PWMMR1 = 2000;      // 180 degree
        PWMLER = (1<<1);
        delay_ms(1000);
    }
}
