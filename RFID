#include "header.h"

CAN_MSG msg;

int main()
{
    char tag[12];

    uart0_init(9600);
    can2_init();

    while(1)
    {
        rfid_read(tag);

        if(strcmp(tag,"12345678")==0)
        {
            msg.id = 0x100;
            msg.dlc = 1;
            msg.rtr = 0;
            msg.byteA = 1;   // Authorized

            can2_tx(msg);
        }
        else
        {
            msg.id = 0x100;
            msg.dlc = 1;
            msg.byteA = 0;   // Unauthorized

            can2_tx(msg);
        }
    }
}
